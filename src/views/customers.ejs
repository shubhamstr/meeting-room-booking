<%- include('layout/header', { title: 'Select Customer', activeTab: 'customers', selectedCustomer: selectedCustomer, successMessage: successMessage, errorMessage: errorMessage }) %>

<div class="page-header">
  <div class="page-title-row">
    <div>
      <h1 class="page-title">
        <i class="fa-solid fa-address-book" style="color: var(--primary-400);"></i>
        Customer Directory &amp; Selection
      </h1>
      <p class="page-subtitle">
        Search and select a customer to initiate meeting room booking, or register a new client profile.
      </p>
    </div>
    <div>
      <button class="btn btn-primary" data-open-modal="modal-add-customer">
        <i class="fa-solid fa-user-plus"></i>
        <span>Add New Customer</span>
      </button>
    </div>
  </div>
</div>

<!-- Key Metrics Ribbon -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon-wrap indigo">
      <i class="fa-solid fa-users"></i>
    </div>
    <div class="stat-info">
      <div class="stat-val"><%= stats.totalCustomers %></div>
      <div class="stat-lbl">Registered Customers</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon-wrap emerald">
      <i class="fa-solid fa-door-open"></i>
    </div>
    <div class="stat-info">
      <div class="stat-val"><%= stats.totalRooms %></div>
      <div class="stat-lbl">Meeting Spaces</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon-wrap amber">
      <i class="fa-solid fa-calendar-check"></i>
    </div>
    <div class="stat-info">
      <div class="stat-val"><%= stats.todayBookingsCount %></div>
      <div class="stat-lbl">Bookings Today</div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-icon-wrap cyan">
      <i class="fa-solid fa-business-time"></i>
    </div>
    <div class="stat-info">
      <div class="stat-val"><%= stats.activeBookings %></div>
      <div class="stat-lbl">Confirmed Sessions</div>
    </div>
  </div>
</div>

<!-- Search Bar Box -->
<div class="search-filter-box">
  <div class="search-input-group">
    <i class="fa-solid fa-magnifying-glass"></i>
    <input 
      type="text" 
      id="customer-search-input" 
      class="search-input" 
      placeholder="Search by customer name, company, email, or department..." 
      value="<%= searchQuery || '' %>"
      autocomplete="off"
    >
  </div>
  <div class="filter-group">
    <span style="font-size: 0.85rem; color: var(--text-muted);">Showing <strong><%= customers.length %></strong> customers</span>
  </div>
</div>

<!-- Customers Grid -->
<div class="customers-grid" id="customers-grid">
  <% customers.forEach(cust => { %>
    <div 
      class="customer-card" 
      data-id="<%= cust.id %>"
      data-name="<%= cust.name %>"
      data-email="<%= cust.email %>"
      data-company="<%= cust.company %>"
      data-department="<%= cust.department %>"
      style="--card-accent: <%= cust.badgeColor %>;"
    >
      <div class="customer-card-header">
        <img 
          src="<%= cust.avatar %>" 
          alt="<%= cust.name %>" 
          class="cust-avatar-large"
          onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(cust.name) %>&background=6366f1&color=fff'"
        >
        <div>
          <h3 class="cust-card-title"><%= cust.name %></h3>
          <div class="cust-company">
            <i class="fa-solid fa-building" style="font-size: 0.75rem; margin-right: 0.25rem;"></i>
            <%= cust.company %>
          </div>
        </div>
      </div>

      <div class="customer-details">
        <div class="cust-detail-item">
          <i class="fa-regular fa-envelope"></i>
          <span><%= cust.email %></span>
        </div>
        <div class="cust-detail-item">
          <i class="fa-solid fa-phone"></i>
          <span><%= cust.phone %></span>
        </div>
        <div class="cust-detail-item">
          <i class="fa-solid fa-sitemap"></i>
          <span><%= cust.department %></span>
        </div>
      </div>

      <div class="customer-card-footer">
        <div class="booking-badge">
          <i class="fa-solid fa-ticket" style="color: var(--primary-400); margin-right: 0.3rem;"></i>
          <%= cust.bookingCount %> <%= cust.bookingCount === 1 ? 'Booking' : 'Bookings' %>
        </div>

        <a href="/book?customerId=<%= cust.id %>" class="btn btn-primary btn-sm">
          <span>Book Room</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  <% }) %>
</div>

<!-- Empty State for Search -->
<div class="empty-state" id="no-customers-found" style="display: none;">
  <div class="empty-state-icon">
    <i class="fa-solid fa-user-xmark"></i>
  </div>
  <p class="empty-state-text">No matching customers found. Try adjusting your search query or add a new customer.</p>
  <button class="btn btn-primary btn-sm" data-open-modal="modal-add-customer">
    <i class="fa-solid fa-plus"></i> Add New Customer
  </button>
</div>

<!-- Modal: Add New Customer -->
<div class="modal-overlay" id="modal-add-customer">
  <div class="modal-content">
    <div class="modal-header">
      <h2 class="modal-title">
        <i class="fa-solid fa-user-plus" style="color: var(--primary-400); margin-right: 0.4rem;"></i>
        Add Customer Profile
      </h2>
      <button class="modal-close" data-close-modal>&times;</button>
    </div>
    
    <form action="/customers/new" method="POST">
      <div class="form-group">
        <label class="form-label" for="cust-name">Full Name *</label>
        <input type="text" id="cust-name" name="name" class="form-input" placeholder="e.g. Jordan Miller" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="cust-email">Email Address *</label>
        <input type="email" id="cust-email" name="email" class="form-input" placeholder="e.g. jordan.m@company.com" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="cust-company">Company / Organization *</label>
        <input type="text" id="cust-company" name="company" class="form-input" placeholder="e.g. Apex Global Tech" required>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label" for="cust-dept">Department</label>
          <input type="text" id="cust-dept" name="department" class="form-input" placeholder="e.g. Product Strategy">
        </div>

        <div class="form-group">
          <label class="form-label" for="cust-phone">Phone Number</label>
          <input type="text" id="cust-phone" name="phone" class="form-input" placeholder="+1 (555) 000-0000">
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
        <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
        <button type="submit" class="btn btn-primary">
          <i class="fa-solid fa-check"></i>
          <span>Save &amp; Continue</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('layout/footer') %>
