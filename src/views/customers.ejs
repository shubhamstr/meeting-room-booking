<%- include('layout/header', { title: 'Customer Directory & Integrations', activeTab: 'customers', selectedCustomer: null, successMessage: successMessage, errorMessage: errorMessage, infoMessage: infoMessage }) %>

<div class="landing-container">
  
  <div class="page-intro-header">
    <h1 class="landing-main-title">Integrations & Customer Hub</h1>
    <p class="landing-subtitle">
      Connect your CRM & Calendar to automatically synchronize contacts and manage meeting room bookings via PostgreSQL.
    </p>
  </div>

  <!-- Compact Integrations Grid -->
  <div class="integrations-grid-compact">

    <!-- 1. ZOHO CRM INTEGRATION CARD (COMPACT) -->
    <div class="compact-integration-card zoho-compact-card">
      <div class="compact-card-header">
        <div class="compact-card-identity">
          <div class="compact-icon-wrap zoho-icon">
            <i class="fa-solid fa-cloud-bolt"></i>
          </div>
          <div>
            <h3 class="compact-card-title">Zoho CRM</h3>
            <span class="compact-card-type">OAuth 2.0 Contacts Sync</span>
          </div>
        </div>
        <% if (typeof zohoStatus !== 'undefined' && zohoStatus && zohoStatus.connected) { %>
          <span class="status-pill status-connected">
            <span class="pulse-dot-sm green"></span> Connected
          </span>
        <% } else { %>
          <span class="status-pill status-disconnected">
            <span class="pulse-dot-sm grey"></span> Not Connected
          </span>
        <% } %>
      </div>

      <div class="compact-card-body">
        <% if (typeof zohoStatus !== 'undefined' && zohoStatus && zohoStatus.connected) { %>
          <div class="compact-meta-row">
            <span class="meta-label"><i class="fa-solid fa-building"></i> Org:</span>
            <span class="meta-val"><%= zohoStatus.organization ? zohoStatus.organization.companyName : 'Connected Account' %></span>
          </div>
          <div class="compact-meta-row">
            <span class="meta-label"><i class="fa-solid fa-server"></i> DC:</span>
            <span class="meta-val"><%= zohoStatus.dataCenter %> &bull; PostgreSQL DB</span>
          </div>
          <% if (zohoStatus.lastSyncedAt) { %>
            <div class="compact-meta-row">
              <span class="meta-label"><i class="fa-solid fa-clock-rotate-left"></i> Synced:</span>
              <span class="meta-val highlight-green"><%= new Date(zohoStatus.lastSyncedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
          <% } %>
        <% } else { %>
          <p class="compact-card-desc">
            Sync leads and contacts directly into PostgreSQL via Zoho CRM API.
          </p>
        <% } %>
      </div>

      <div class="compact-card-actions">
        <% if (typeof zohoStatus !== 'undefined' && zohoStatus && zohoStatus.connected) { %>
          <form action="/api/zoho/sync" method="POST" id="zoho-sync-form" style="margin: 0; flex: 1;">
            <button type="submit" id="zoho-sync-btn" class="btn btn-primary btn-sm" style="width: 100%;">
              <i class="fa-solid fa-arrows-rotate"></i>
              <span>Sync CRM to DB</span>
            </button>
          </form>
          <form action="/api/zoho/disconnect" method="POST" style="margin: 0;">
            <button type="submit" class="btn btn-secondary btn-sm" title="Disconnect Zoho CRM">
              <i class="fa-solid fa-plug-circle-xmark"></i>
            </button>
          </form>
        <% } else { %>
          <a href="/api/zoho/connect" class="btn btn-zoho btn-sm" style="width: 100%;">
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
            <span>Connect Zoho CRM</span>
          </a>
        <% } %>
      </div>
    </div>

    <!-- 2. GOOGLE CALENDAR INTEGRATION CARD (COMPACT) -->
    <div class="compact-integration-card calendar-compact-card">
      <div class="compact-card-header">
        <div class="compact-card-identity">
          <div class="compact-icon-wrap calendar-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div>
            <h3 class="compact-card-title">Google Calendar</h3>
            <span class="compact-card-type">Event Sync &amp; Booking API</span>
          </div>
        </div>
        <% if (typeof calendarStatus !== 'undefined' && calendarStatus && calendarStatus.connected) { %>
          <span class="status-pill status-connected">
            <span class="pulse-dot-sm green"></span> Connected
          </span>
        <% } else { %>
          <span class="status-pill status-disconnected">
            <span class="pulse-dot-sm grey"></span> Not Connected
          </span>
        <% } %>
      </div>

      <div class="compact-card-body">
        <% if (typeof calendarStatus !== 'undefined' && calendarStatus && calendarStatus.connected) { %>
          <div class="compact-meta-row">
            <span class="meta-label"><i class="fa-regular fa-envelope"></i> User:</span>
            <span class="meta-val" title="<%= calendarStatus.userEmail || '' %>"><%= calendarStatus.userEmail || 'Active Calendar User' %></span>
          </div>
          <div class="compact-meta-row">
            <span class="meta-label"><i class="fa-solid fa-bolt"></i> API:</span>
            <span class="meta-val">Google Calendar v3</span>
          </div>
        <% } else { %>
          <p class="compact-card-desc">
            Automatically create Google Calendar invites for reserved meeting room slots.
          </p>
        <% } %>
      </div>

      <div class="compact-card-actions">
        <% if (typeof calendarStatus !== 'undefined' && calendarStatus && calendarStatus.connected) { %>
          <form action="/api/calendar/sync" method="POST" style="margin: 0; flex: 1;">
            <button type="submit" class="btn btn-primary btn-sm" style="width: 100%; background: linear-gradient(135deg, #10b981, #059669); border-color: #10b981;">
              <i class="fa-solid fa-cloud-arrow-up"></i>
              <span>Sync Bookings</span>
            </button>
          </form>
          <form action="/api/calendar/disconnect" method="POST" style="margin: 0;">
            <button type="submit" class="btn btn-secondary btn-sm" title="Disconnect Calendar">
              <i class="fa-solid fa-plug-circle-xmark"></i>
            </button>
          </form>
        <% } else { %>
          <a href="/api/calendar/connect" class="btn btn-calendar btn-sm" style="width: 100%;">
            <i class="fa-brands fa-google"></i>
            <span>Connect Calendar</span>
          </a>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Synced Customers Directory (PostgreSQL Database Table UI via /api/customers) -->
  <div class="customers-directory-section">
    <div class="directory-header-row">
      <div>
        <div class="directory-title-wrap">
          <h2 class="directory-main-title">
            <i class="fa-solid fa-database directory-icon"></i>
            PostgreSQL Customer Directory
          </h2>
          <span class="total-count-badge" id="total-customers-badge">
            <i class="fa-solid fa-circle-notch fa-spin"></i> Loading profiles...
          </span>
          <span class="api-endpoint-pill" title="Live data endpoint">
            <i class="fa-solid fa-code"></i> GET /api/customers
          </span>
        </div>
        <p class="directory-subtitle">
          Persisted customer records synced from Zoho CRM & database. Real-time querying via <code>/api/customers</code> endpoint.
        </p>
      </div>

      <!-- Search & Controls Toolbar -->
      <div class="customer-toolbar-wrap">
        <form action="/customers" method="GET" class="customer-db-search-form" id="customer-search-form" onsubmit="return false;">
          <div class="db-search-input-wrap">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input 
              type="text" 
              name="search" 
              id="customer-search-input" 
              placeholder="Search name or email..." 
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              autocomplete="off"
            >
            <button type="button" class="search-clear-btn" id="customer-search-clear" title="Clear search" style="<%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'display: inline-flex;' : 'display: none;' %>">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
          
          <div class="table-page-size-wrap">
            <select id="customer-limit-select" class="limit-dropdown" title="Rows per page">
              <option value="5">5 / page</option>
              <option value="10" selected>10 / page</option>
              <option value="20">20 / page</option>
              <option value="50">50 / page</option>
            </select>
          </div>

          <button type="button" id="api-refresh-btn" class="btn btn-secondary btn-sm refresh-api-btn" title="Fetch fresh data from /api/customers">
            <i class="fa-solid fa-arrows-rotate" id="api-refresh-icon"></i>
            <span>Refresh</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Loading State Skeleton / Spinner -->
    <div id="customers-loading-state" class="table-loading-container">
      <div class="loading-spinner-wrap">
        <i class="fa-solid fa-circle-notch fa-spin loading-spinner-icon"></i>
      </div>
      <p class="loading-text">Fetching live data from <code>/api/customers</code>...</p>
    </div>

    <!-- Error State Container -->
    <div id="customers-error-state" class="directory-empty-card directory-error-card" style="display: none;">
      <div class="empty-icon-circle error-circle">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <h3 class="empty-title">Error Loading Customers</h3>
      <p class="empty-desc error-message-text">Failed to fetch customer data from /api/customers endpoint.</p>
      <button type="button" class="btn btn-primary btn-sm" id="api-retry-btn">
        <i class="fa-solid fa-rotate-right"></i>
        <span>Retry API Call</span>
      </button>
    </div>

    <!-- Table Card Container -->
    <div class="customers-table-card" id="customers-table-card" style="display: none;">
      <div class="table-responsive">
        <table class="modern-customers-table">
          <thead>
            <tr>
              <th style="width: 30%;">Customer</th>
              <th style="width: 25%;">Email</th>
              <th style="width: 18%;">Company</th>
              <th style="width: 12%;">Bookings</th>
              <th style="width: 15%; text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody id="customers-table-body">
            <!-- Dynamically populated via GET /api/customers endpoint -->
          </tbody>
        </table>
      </div>

      <!-- Table Footer Pagination -->
      <div class="table-pagination-footer" id="customers-pagination-footer" style="display: none;">
        <!-- Dynamically populated via GET /api/customers endpoint -->
      </div>
    </div>

    <!-- Empty State -->
    <div class="directory-empty-card" id="customers-empty-state" style="display: none;">
      <div class="empty-icon-circle">
        <i class="fa-solid fa-magnifying-glass"></i>
      </div>
      <div class="empty-query-wrap" style="display: none;">
        <h3 class="empty-title">No Customers Found</h3>
        <p class="empty-desc">
          No records matched your search query <strong class="empty-query-text"></strong>.
        </p>
        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('customer-search-clear').click();">
          <i class="fa-solid fa-rotate-left"></i>
          <span>Clear Search</span>
        </button>
      </div>
      <div class="empty-default-wrap" style="display: none;">
        <h3 class="empty-title">No Customers in PostgreSQL Yet</h3>
        <p class="empty-desc">
          Connect your <strong>Zoho CRM</strong> account and sync live contacts directly into your database.
        </p>
        <a href="/api/zoho/connect" class="btn btn-zoho">
          <i class="fa-solid fa-cloud-bolt"></i>
          <span>Connect &amp; Sync Zoho CRM</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Quick Navigation Panel -->
  <div class="quick-nav-panel" style="margin-top: 2.5rem;">
    <div class="quick-nav-header">
      <h3>Quick System Access</h3>
      <p>Manage meeting room bookings, slot reservations, and check PostgreSQL queues.</p>
    </div>
    <div class="quick-nav-buttons">
      <a href="/book" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-calendar-plus"></i>
        <span>Book a Room</span>
      </a>
      <a href="/bookings" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-list-check"></i>
        <span>View Reservations</span>
      </a>
      <a href="/api/health" target="_blank" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-heart-pulse"></i>
        <span>API Health</span>
      </a>
    </div>
  </div>

</div>

<style>
  .landing-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .page-intro-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .landing-main-title {
    font-size: 2.1rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin-bottom: 0.4rem;
  }

  .landing-subtitle {
    font-size: 0.98rem;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Compact Integrations Grid */
  .integrations-grid-compact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .compact-integration-card {
    background: linear-gradient(145deg, rgba(22, 30, 48, 0.85), rgba(15, 20, 32, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .compact-integration-card:hover {
    border-color: rgba(99, 102, 241, 0.3);
    transform: translateY(-2px);
  }

  .compact-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .compact-card-identity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .compact-icon-wrap {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    color: #fff;
    flex-shrink: 0;
  }

  .zoho-icon {
    background: linear-gradient(135deg, #ea4335, #ff5722);
    box-shadow: 0 4px 14px rgba(234, 67, 53, 0.35);
  }

  .calendar-icon {
    background: linear-gradient(135deg, #4285f4, #1a73e8);
    box-shadow: 0 4px 14px rgba(66, 133, 244, 0.35);
  }

  .compact-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
  }

  .compact-card-type {
    font-size: 0.75rem;
    color: var(--text-dim);
    display: block;
    margin-top: 0.15rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .status-pill.status-connected {
    background: rgba(16, 185, 129, 0.12);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  .status-pill.status-disconnected {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-dim);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pulse-dot-sm {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pulse-dot-sm.green {
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .pulse-dot-sm.grey {
    background: #64748b;
  }

  .compact-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.83rem;
    background: rgba(11, 15, 25, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
  }

  .compact-card-desc {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0;
  }

  .compact-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }

  .meta-label {
    color: var(--text-dim);
    font-size: 0.78rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .meta-val {
    color: #f1f5f9;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meta-val.highlight-green {
    color: #6ee7b7;
  }

  .compact-card-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .btn-calendar {
    background: linear-gradient(135deg, #4285f4, #1a73e8);
    color: #ffffff;
    font-weight: 600;
    border: none;
    box-shadow: 0 4px 14px rgba(66, 133, 244, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .btn-calendar:hover {
    box-shadow: 0 6px 18px rgba(66, 133, 244, 0.5);
    transform: translateY(-1px);
    color: #fff;
  }

  /* PostgreSQL Directory Header */
  .customers-directory-section {
    margin-top: 1rem;
  }

  .directory-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .directory-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .directory-main-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .directory-icon {
    color: var(--primary-400);
    font-size: 1.2rem;
  }

  .total-count-badge {
    background: rgba(99, 102, 241, 0.15);
    color: var(--primary-400);
    border: 1px solid rgba(99, 102, 241, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .api-endpoint-pill {
    background: rgba(6, 182, 212, 0.12);
    color: #67e8f9;
    border: 1px solid rgba(6, 182, 212, 0.3);
    font-size: 0.72rem;
    font-weight: 700;
    font-family: monospace;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    letter-spacing: 0.02em;
  }

  .directory-subtitle {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
  }

  .directory-subtitle code {
    font-size: 0.82rem;
    background: rgba(99, 102, 241, 0.15);
    color: var(--primary-400);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: monospace;
  }

  /* Customer Toolbar */
  .customer-toolbar-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .customer-db-search-form {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .db-search-input-wrap {
    position: relative;
    min-width: 250px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-dim);
    font-size: 0.85rem;
    pointer-events: none;
  }

  .db-search-input-wrap input {
    width: 100%;
    padding: 0.52rem 2.2rem 0.52rem 2.25rem;
    background: rgba(18, 24, 38, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    color: #fff;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .db-search-input-wrap input:focus {
    border-color: var(--primary-500);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }

  .search-clear-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.85rem;
    padding: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .search-clear-btn:hover {
    color: #fff;
  }

  .limit-dropdown {
    background: rgba(18, 24, 38, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    color: #cbd5e1;
    font-size: 0.84rem;
    padding: 0.52rem 0.75rem;
    outline: none;
    cursor: pointer;
    font-weight: 500;
    transition: border-color 0.2s ease;
  }

  .limit-dropdown:focus {
    border-color: var(--primary-500);
  }

  .limit-dropdown option {
    background: #121826;
    color: #fff;
  }

  .refresh-api-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Table Loading State */
  .table-loading-container {
    background: rgba(22, 30, 48, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 3rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .loading-spinner-wrap {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loading-spinner-icon {
    font-size: 1.5rem;
    color: var(--primary-400);
  }

  .loading-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
  }

  .loading-text code {
    background: rgba(99, 102, 241, 0.15);
    color: var(--primary-400);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-family: monospace;
  }

  /* Error State Card */
  .directory-error-card {
    border-color: rgba(239, 68, 68, 0.3);
    background: rgba(30, 15, 20, 0.6);
  }

  .error-circle {
    background: rgba(239, 68, 68, 0.15) !important;
    color: #f87171 !important;
  }

  .fade-in-row {
    animation: fadeInRow 0.25s ease-out;
  }

  @keyframes fadeInRow {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Modern Customers Table */
  .customers-table-card {
    background: linear-gradient(145deg, rgba(22, 30, 48, 0.85), rgba(15, 20, 32, 0.9));
