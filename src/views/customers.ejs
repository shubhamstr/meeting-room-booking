<%- include('layout/header', { title: 'Zoho CRM Integration', activeTab: 'customers', selectedCustomer: null, successMessage: successMessage, errorMessage: errorMessage }) %>

<div class="landing-container">
  <div class="landing-card">
    <div class="landing-icon-wrap">
      <i class="fa-solid fa-bolt-lightning"></i>
    </div>
    
    <h1 class="landing-title">Connect to Zoho CRM</h1>
    <p class="landing-subtitle">
      Authorize and establish a secure connection with Zoho CRM APIs using <code>@zohocrm/nodejs-sdk-2.0</code>.
    </p>

    <% if (typeof zohoStatus !== 'undefined' && zohoStatus && zohoStatus.connected) { %>
      <!-- Connected State -->
      <div class="landing-status-box connected">
        <div class="status-indicator">
          <span class="pulse-dot"></span>
        </div>
        <div class="status-details">
          <div class="status-label">Zoho CRM Connected</div>
          <div class="status-org">
            Organization: <strong><%= zohoStatus.organization ? zohoStatus.organization.companyName : 'Connected Account' %></strong>
          </div>
          <div class="status-meta">
            Data Center: <span><%= zohoStatus.dataCenter %></span> &bull; Client ID: <span><%= zohoStatus.clientId %></span>
          </div>
        </div>
      </div>

      <div class="landing-actions">
        <form action="/zoho/disconnect" method="POST" style="margin: 0;">
          <button type="submit" class="btn btn-secondary">
            <i class="fa-solid fa-plug-circle-xmark"></i>
            <span>Disconnect CRM</span>
          </button>
        </form>
      </div>
    <% } else { %>
      <!-- Disconnected State: Single Connect Button -->
      <div class="landing-status-box disconnected">
        <div class="status-indicator">
          <span class="pulse-dot grey"></span>
        </div>
        <div class="status-details">
          <div class="status-label">Status: Not Connected</div>
          <div class="status-meta">
            Click below to authorize via Zoho Accounts OAuth 2.0
          </div>
        </div>
      </div>

      <div class="landing-actions">
        <a href="/zoho/connect" class="btn btn-zoho btn-lg">
          <i class="fa-solid fa-arrow-right-to-bracket"></i>
          <span>Connect to Zoho CRM</span>
        </a>
      </div>
    <% } %>
  </div>
</div>

<style>
  .landing-container {
    min-height: calc(80vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .landing-card {
    background: linear-gradient(145deg, rgba(22, 30, 48, 0.9), rgba(15, 20, 32, 0.95));
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    max-width: 580px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(16px);
  }

  .landing-icon-wrap {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    border-radius: 16px;
    background: linear-gradient(135deg, #ea4335, #ff5722);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: #fff;
    box-shadow: 0 8px 24px rgba(234, 67, 53, 0.4);
  }

  .landing-title {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .landing-subtitle {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .landing-subtitle code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    color: var(--primary-400);
    font-size: 0.88rem;
  }

  .landing-status-box {
    display: flex;
    align-items: center;
    text-align: left;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    border-radius: 14px;
    margin-bottom: 2rem;
    background: rgba(18, 24, 38, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .landing-status-box.connected {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.35);
  }

  .landing-status-box.disconnected {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .status-label {
    font-weight: 700;
    font-size: 0.98rem;
    color: #ffffff;
  }

  .status-org {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .status-meta {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-top: 0.25rem;
  }

  .landing-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .btn-lg {
    padding: 0.85rem 2rem;
    font-size: 1.05rem;
    border-radius: 12px;
  }
</style>

<%- include('layout/footer') %>
