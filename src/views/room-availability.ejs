<%- include('layout/header', { title: room.name + ' Availability & Booking', activeTab: 'book', selectedCustomer: customer, successMessage: successMessage, errorMessage: errorMessage }) %>

<div class="availability-container">

  <!-- Active Customer Context Banner -->
  <% if (customer) { %>
    <div class="selected-customer-banner">
      <div class="banner-user-info">
        <div class="banner-avatar-wrap">
          <%= customer.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase() %>
        </div>
        <div class="banner-user-text">
          <h3>
            <span><%= customer.name %></span>
            <span class="active-cust-pill">
              <i class="fa-solid fa-user-check"></i> Booking Customer
            </span>
            <% if (customer.zohoId) { %>
              <span class="table-zoho-badge" style="font-size: 0.72rem; padding: 0.15rem 0.5rem;">
                <i class="fa-solid fa-cloud-bolt"></i> Zoho CRM
              </span>
            <% } %>
          </h3>
          <p>
            <i class="fa-solid fa-building"></i> <%= customer.company || 'Independent Client' %> &bull; 
            <i class="fa-regular fa-envelope"></i> <%= customer.email %>
          </p>
        </div>
      </div>

      <div class="banner-actions">
        <a href="/customers" class="btn btn-secondary btn-sm">
          <i class="fa-solid fa-arrow-right-arrow-left"></i>
          <span>Change Customer</span>
        </a>
      </div>
    </div>
  <% } %>

  <!-- Selected Room Hero Bar -->
  <div class="room-hero-card">
    <div class="room-hero-left">
      <img src="<%= room.image %>" alt="<%= room.name %>" class="room-hero-thumb">
      <div class="room-hero-meta">
        <div class="room-hero-tag-row">
          <span class="room-type-badge"><%= room.type %></span>
          <span class="room-floor-badge"><i class="fa-solid fa-location-dot"></i> <%= room.floor %></span>
          <span class="room-capacity-badge"><i class="fa-solid fa-users"></i> Up to <%= room.capacity %> Seats</span>
        </div>
        <h2 class="room-hero-title"><%= room.name %></h2>
        <p class="room-hero-desc"><%= room.description %></p>
        <div class="hero-amenities-wrap">
          <% (room.amenities || []).forEach(a => { %>
            <span class="hero-amenity-chip"><i class="fa-solid fa-check"></i> <%= a %></span>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="room-hero-right">
      <div class="room-price-display">
        <span class="price-val">$<%= room.hourlyRate %></span>
        <span class="price-lbl">/ hour</span>
      </div>
      <a href="/rooms<%= customer ? `?customerId=${customer.id}` : '' %>" class="btn btn-secondary btn-sm" style="margin-top: 0.5rem; width: 100%;">
        <i class="fa-solid fa-grid-2"></i>
        <span>Change Room</span>
      </a>
    </div>
  </div>

  <!-- Availability & Instant Slot Booking Layout (Full Width) -->
  <div class="availability-fullscreen-wrap">

    <!-- Date Selection & Status Header -->
    <div class="availability-toolbar-card">
      <div class="toolbar-header-row">
        <div>
          <div class="toolbar-title-wrap">
            <h3 class="toolbar-title">
              <i class="fa-solid fa-calendar-day" style="color: var(--primary-400);"></i>
              Schedule &amp; Availability
            </h3>
            <span class="api-endpoint-pill" title="Live slot availability API">
              <i class="fa-solid fa-code"></i> GET /api/rooms/<%= room.id %>/availability?date=<span id="api-date-display"><%= date %></span>
            </span>
            <span class="api-endpoint-pill" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.35); color: #6ee7b7;" title="Direct Instant Booking API">
              <i class="fa-solid fa-bolt"></i> POST /bookings
            </span>
          </div>
          <p class="toolbar-subtitle">Select date and click any available time slot below to instantly reserve this meeting space.</p>
        </div>

        <!-- Slot Counters Breakdown -->
        <div class="slot-summary-counters">
          <span class="counter-badge counter-free" id="free-count-badge">
            <i class="fa-solid fa-circle-check"></i> <strong><%= freeSlots.length %></strong> Free
          </span>
          <span class="counter-badge counter-busy" id="busy-count-badge">
            <i class="fa-solid fa-lock"></i> <strong><%= busySlots.length %></strong> Busy
          </span>
          <span class="counter-badge counter-total" id="total-count-badge">
            <i class="fa-solid fa-clock"></i> <strong><%= slots.length %></strong> Total
          </span>
        </div>
      </div>

      <!-- Date Controls Row -->
      <div class="date-controls-row">
        <div class="date-input-group">
          <label for="slot-date-picker" class="date-input-label">
            <i class="fa-regular fa-calendar-check"></i> Meeting Date:
          </label>
          <input 
            type="date" 
            id="slot-date-picker" 
            class="modern-date-input" 
            value="<%= date %>" 
            data-room-id="<%= room.id %>"
            data-customer-id="<%= customer ? customer.id : '' %>"
            data-customer-name="<%= customer ? customer.name : '' %>"
            data-room-name="<%= room.name %>"
          >
        </div>

        <!-- Quick Date Shortcut Buttons -->
        <div class="quick-date-buttons">
          <button type="button" class="quick-date-btn active" data-offset="0">Today</button>
          <button type="button" class="quick-date-btn" data-offset="1">Tomorrow</button>
          <button type="button" class="quick-date-btn" data-offset="2">+2 Days</button>
        </div>

        <button type="button" id="refresh-slots-btn" class="btn btn-secondary btn-sm" title="Re-fetch slot availability from API">
          <i class="fa-solid fa-arrows-rotate" id="refresh-slots-icon"></i>
          <span>Refresh</span>
        </button>
      </div>
    </div>

    <!-- Slots Loading Spinner -->
    <div id="slots-loading-state" class="table-loading-container" style="display: none; margin: 2rem 0;">
      <div class="loading-spinner-wrap">
        <i class="fa-solid fa-circle-notch fa-spin loading-spinner-icon"></i>
      </div>
      <p class="loading-text">Fetching live slots from <code>GET /api/rooms/<%= room.id %>/availability</code>...</p>
    </div>

    <!-- SECTION 1: FREE SLOTS (Available for Instant Booking) -->
    <div class="slots-section-card free-slots-card" id="free-slots-section">
      <div class="slots-section-header">
        <div class="section-title-wrap">
          <span class="status-indicator-dot green"></span>
          <h4 class="section-title">Available Slots (<span id="free-slots-header-count"><%= freeSlots.length %></span>)</h4>
        </div>
        <span class="section-hint"><i class="fa-solid fa-bolt" style="color: #67e8f9;"></i> Click any slot below to instantly call <code>POST /bookings</code> and reserve</span>
      </div>

      <div class="slots-grid-wrap" id="free-slots-grid">
        <% if (freeSlots.length === 0) { %>
          <div class="no-slots-notice">
            <i class="fa-solid fa-calendar-xmark"></i>
            <span>No free slots remaining on this day. Please pick a different date above.</span>
          </div>
        <% } else { %>
          <% freeSlots.forEach(slot => { %>
            <div 
              class="modern-slot-card free-slot-card" 
              data-slot-id="<%= slot.id %>" 
              data-slot-label="<%= slot.label %>"
              data-slot-time="<%= slot.time %>"
              data-slot-period="<%= slot.period %>"
              title="Click to instantly book <%= slot.label %>"
            >
              <div class="slot-card-top">
                <span class="slot-period-tag"><%= slot.period %></span>
                <span class="slot-available-pill">
                  <i class="fa-solid fa-circle-dot"></i> Free
                </span>
              </div>
              <div class="slot-time-display">
                <%= slot.label %>
              </div>
              <div class="slot-card-bottom">
                <span class="slot-price-hint">$<%= room.hourlyRate %>/hr</span>
                <span class="slot-action-text"><i class="fa-solid fa-calendar-check"></i> Book Now</span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- SECTION 2: BUSY SLOTS (Already Booked) -->
    <div class="slots-section-card busy-slots-card" id="busy-slots-section">
      <div class="slots-section-header">
        <div class="section-title-wrap">
          <span class="status-indicator-dot red"></span>
          <h4 class="section-title">Reserved / Busy Slots (<span id="busy-slots-header-count"><%= busySlots.length %></span>)</h4>
        </div>
        <span class="section-hint">Unavailable time slots already reserved in PostgreSQL</span>
      </div>

      <div class="slots-grid-wrap" id="busy-slots-grid">
        <% if (busySlots.length === 0) { %>
          <div class="all-free-notice">
            <i class="fa-solid fa-circle-check"></i>
            <span>All slots are wide open! Room is fully available throughout the entire day.</span>
          </div>
        <% } else { %>
          <% busySlots.forEach(slot => { %>
            <div class="modern-slot-card busy-slot-card">
              <div class="slot-card-top">
                <span class="slot-period-tag"><%= slot.period %></span>
                <span class="slot-busy-pill">
                  <i class="fa-solid fa-lock"></i> Reserved
                </span>
              </div>
              <div class="slot-time-display">
                <%= slot.label %>
              </div>
              <div class="slot-card-bottom">
                <span class="slot-reserved-by" title="<%= slot.bookedBy || 'Reserved' %>">
                  <i class="fa-solid fa-user"></i> <%= slot.bookedBy || 'Reserved' %>
                </span>
                <span class="slot-busy-status">Locked</span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </div>

</div>

<%- include('layout/footer') %>
