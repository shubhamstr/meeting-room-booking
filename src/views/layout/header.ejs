<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | TurboSpace' : 'TurboSpace - Meeting Room Booking' %></title>
  <meta name="description" content="Modern meeting room booking system with Zoho CRM and Google Calendar integrations">
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- FontAwesome Icons for aesthetics -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Top Navigation Bar -->
  <nav class="navbar" id="main-nav">
    <div class="nav-container">
      <a href="/customers" class="brand">
        <div class="brand-icon">
          <i class="fa-solid fa-cube"></i>
        </div>
        <div>
          <span class="brand-title">Meeting Room Booking</span>
        </div>
      </a>



      <!-- Status Badges -->
      <div class="nav-right-actions" style="display: flex; align-items: center; gap: 0.75rem;">
        <% if (typeof zohoStatus !== 'undefined' && zohoStatus && zohoStatus.connected) { %>
          <div class="zoho-nav-badge connected" title="Zoho CRM Connected (<%= zohoStatus.dataCenter %>)">
            <span class="pulse-dot"></span>
            <i class="fa-solid fa-cloud-bolt"></i>
            <span>Zoho CRM</span>
          </div>
        <% } %>

        <% if (typeof calendarStatus !== 'undefined' && calendarStatus && calendarStatus.connected) { %>
          <div class="zoho-nav-badge connected" style="background: rgba(66, 133, 244, 0.15); border-color: rgba(66, 133, 244, 0.4); color: #93c5fd;" title="Google Calendar Connected (<%= calendarStatus.userEmail || '' %>)">
            <span class="pulse-dot" style="background: #4285f4; box-shadow: 0 0 8px #4285f4;"></span>
            <i class="fa-brands fa-google"></i>
            <span>Calendar</span>
          </div>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Alert / Flash notification banner if any -->
  <main class="main-wrapper">
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="alert-banner success" id="flash-success">
        <i class="fa-solid fa-circle-check"></i>
        <span><%= successMessage %></span>
      </div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert-banner error" id="flash-error">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= errorMessage %></span>
      </div>
    <% } %>

    <% if (typeof infoMessage !== 'undefined' && infoMessage) { %>
      <div class="alert-banner info" id="flash-info" style="background: rgba(59, 130, 246, 0.15); border-left: 4px solid #3b82f6; color: #93c5fd; padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
        <i class="fa-solid fa-circle-info"></i>
        <span><%= infoMessage %></span>
      </div>
    <% } %>
