PORT=5000
NODE_ENV=development

# Zoho CRM OAuth Credentials
ZOHO_API_CLIENT_ID=
ZOHO_API_CLIENT_SECRET=

# Optional: Data Center (e.g. INDataCenter, USDataCenter, EUDataCenter, AUDataCenter)
ZOHO_DATA_CENTER=INDataCenter

# Optional: OAuth Redirect URI (must match the URI in Zoho Developer Console)
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho-redirect

# Optional: Current Zoho User Email for SDK Signature
ZOHO_CURRENT_USER_EMAIL=shubhamsutar5799@gmail.com